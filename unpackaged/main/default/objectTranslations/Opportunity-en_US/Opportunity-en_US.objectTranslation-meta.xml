    <validationRules>
        <errorMessage><!-- Opportunity Blood Drive is NOT able to project Double Red Procedures because either the Account does not accept automation or the Site isn&apos;t suitable for automation. --></errorMessage>
        <name>Account_Designation_Site_Designation</name>
    </validationRules>
    <validationRules>
        <errorMessage><!-- Since this is a mobile opportunity, you may not move it to the &quot;Closed&quot; Stage without the Account Internal Name field field populated. --></errorMessage>
        <name>Account_Internal_Name_Requirement</name>
    </validationRules>
    <validationRules>
        <errorMessage><!-- Can&apos;t Associating Opportunity to Different Account --></errorMessage>
        <name>Account_name_is_not_editable</name>
    </validationRules>
    <validationRules>
        <errorMessage><!-- You can&apos;t update additional description. --></errorMessage>
        <name>Additional_Description_not_Update</name>
    </validationRules>
    <validationRules>
        <errorMessage><!-- Anticipated Registered Donors Change Reason is required while updating Anticipated Registered Donors --></errorMessage>
        <name>AnticipatedRegiDonorChangeReasonRequired</name>
    </validationRules>
    <validationRules>
        <errorMessage><!-- A non-zero value is required for Anticipated Registered Donors because the Site&apos;s Operation Type is &quot;Non Integrated WB&quot; --></errorMessage>
        <name>Anticipated_Registered_Donors_Required</name>
    </validationRules>
    <validationRules>
        <errorMessage><!-- In order to mark this opportunity stage = canceled, please select initiated by and cancellation reasons first. --></errorMessage>
        <name>Cancellation_Reason_Required</name>
    </validationRules>
    <validationRules>
        <errorMessage><!-- A Blood Drive Opportunity cannot move back once it has moved to the next Stage in the Lifecycle --></errorMessage>
        <name>CannotMoveBackOnStagesThatAreCompleted</name>
    </validationRules>
    <validationRules>
        <errorMessage><!-- Drive Date change interferes with Taxonomy effective dates. Please cancel and rebook. Any scheduled donors should be managed through the Notifying Donors of Drive Change policy. --></errorMessage>
        <name>Cannot_change_Drive_Date_across_Taxonomy</name>
    </validationRules>
    <validationRules>
        <errorMessage><!-- Drive Date cannot be changed on the Opportunity to a completed/cancelled Drive. --></errorMessage>
        <name>Cannot_change_Drive_Date_can_com_status</name>
    </validationRules>
    <validationRules>
        <errorMessage><!-- This drive is in Confirmed Drive Status, a date change is no longer permitted. You must cancel and add a new opportunity. --></errorMessage>
        <name>Cannot_change_Drive_Date_confirm_status</name>
    </validationRules>
    <validationRules>
        <errorMessage><!-- Blood Drive Opportunity creation is not allowed from this New link --></errorMessage>
        <name>Check_Data_Source_of_Drive</name>
    </validationRules>
    <validationRules>
        <errorMessage><!-- Drives may not be scheduled for dates prior to today&apos;s date. --></errorMessage>
        <name>CloseDate_GreaterorEqual_to_TODAY</name>
    </validationRules>
    <validationRules>
        <errorMessage><!-- Close Date cannot be after the Drive Date. --></errorMessage>
        <name>Close_Date_After_Drive_Date</name>
    </validationRules>
    <validationRules>
        <errorMessage><!-- Close Date cannot be before today --></errorMessage>
        <name>Close_Date_Greater_or_Equal_to_TODAY</name>
    </validationRules>
    <validationRules>
        <errorMessage><!-- Only a DRD user, APS Planner, APS Scheduler, Global Admin ,APS Admin, Recruitment Admin or System Administrator is able to update the Close Date. --></errorMessage>
        <name>Close_Date_Only_DRD_System_Admin</name>
    </validationRules>
    <validationRules>
        <errorMessage><!-- Double Red Procedures Projected Change Reason is required while updating Double Red Procedures Projected --></errorMessage>
        <name>DRedProcedureProjectChangeReasonRequired</name>
    </validationRules>
    <validationRules>
        <errorMessage><!-- Always Roll or Do not roll cannot be checked if drive is cancelled --></errorMessage>
        <name>Designate_Rollover_bfore_Cancellation</name>
    </validationRules>
    <validationRules>
        <errorMessage><!-- Double red projected cannot be null --></errorMessage>
        <name>Double_Reds_Cannot_be_null</name>
    </validationRules>
    <validationRules>
        <errorMessage><!-- Drives may not be scheduled for dates prior to today&apos;s date. --></errorMessage>
        <name>Drive_Date_Greater_or_Equal_to_TODAY</name>
    </validationRules>
    <validationRules>
        <errorMessage><!-- Drive Keyword is required if the &quot;Open To Public&quot; field value is &quot;No&quot; and stage is Closed --></errorMessage>
        <name>Drive_Keyword_Required</name>
    </validationRules>
    <validationRules>
        <errorMessage><!-- A Drive Keyword must be entered if a Drive is not open to the public. --></errorMessage>
        <name>Drive_Keyword_Required_Closed_to_Publc</name>
