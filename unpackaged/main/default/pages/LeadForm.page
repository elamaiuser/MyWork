                || event.origin === "https://m.redcrossblood.org"
                || event.origin === "https://redcross.demdex.net"
                || event.origin === "https://biosf--test.sandbox.my.salesforce-sites.com"
                || event.origin === "https://biosf.my.salesforce-sites.com"){
                
			try{               

                let params = (new URL(event.data)).searchParams;

                //let params = new URLSearchParams(window.location.search);

                //HRP 11743- trim string 

                var cidUpdated = params.get('cid');

                console.log("cidUpdated: " + params.get('cid'));
 
                const cid = params.get('cid')

                const med = params.get('med')

                const source = params.get('source')

                const scode = params.get('scode')

                const campdesc = params.get('campdesc')

                const did = params.get('did')

                const bid = params.get('bid')

                const subj = params.get('subj')

                const prty = params.get('prty')

                const nat = params.get('prty')

                const prod = params.get('prod')

                const send = params.get('send')

                const delvid = params.get('delvid')
 
                console.log("Cid: " + cid);

                console.log("Med: " + med);

                console.log("Source: " + source);

                console.log("Scode: " + scode);

                console.log("Campdesc: " + campdesc);

                console.log("did: " + did);

                console.log("bid: " + bid);

                console.log("subj: " + subj);

                console.log("prty: " + prty);

                console.log("nat: " + nat);

                console.log("prod: " + prod);

                console.log("send: " + send);

                console.log("Delvid: " + delvid);
 
                if (cid != '')

                    jQuery('input[id$=cidId]').val(cid);

                if (med != '')

                    jQuery('input[id$=medId]').val(med);

                if (source != '')

                    jQuery('input[id$=sourceId]').val(source);

                if (campdesc != '')

                    jQuery('input[id$=cmpId]').val(campdesc);

                if (did != '')

                    jQuery('input[id$=did]').val(did);

                if (bid != '')

                    jQuery('input[id$=bid]').val(bid);

                if (subj != '')

                    jQuery('input[id$=subj]').val(subj);

                if (prty != '')

                    jQuery('input[id$=prty]').val(prty);

                if (nat != '')

                    jQuery('input[id$=nat]').val(nat);

                if (prod != '')

                    jQuery('input[id$=prod]').val(prod);

                if (send != '')

                    jQuery('input[id$=send]').val(send);

                if (delvid != '')

                    jQuery('input[id$=delvid]').val(delvid);
           
                //only accept messages from appropriate senders
                console.log('Supported origin: ' + event.origin); // comment later
            }
            catch(e){
               console.log(e);
            } 
           }else {
                console.log('Unsupported orgin: ' + event.origin);  // comment later  
                return;
            }
            
           
           });
