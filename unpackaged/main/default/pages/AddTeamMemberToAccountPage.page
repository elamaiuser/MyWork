<apex:page standardController="Account" extensions="AddTeamMemberToAccountExtension" recordSetVar="acc" sidebar="false" showHeader="false" standardStylesheets="false">

    <div id="account_lookup"></div>
    <apex:includeScript value="/lightning/lightning.out.js" />
    <script>
    
    //console.log("concatenatedAccIds is " , '{!concatenatedAccIds}' );
    		
            var visualForceFunction = function(event)
            {
                //let url = "/lightning/o/Account/list?filterName=00Bo0000002SroBEAS";
                let url = "/lightning/o/Account/list?filterName="+ '{!unassignedviewId}';
                window.location.href = url;
                //var myEventData1 = event.getParam("lookupVal");
                //var label = event.getParam("lookupLabel");
                //console.log('response data = ' + myEventData1 + ' : ' + label);
            };
 
            // and...
            $Lightning.use("c:AddTeamMemberAuraApp", function()
            {
                $Lightning.createComponent
                (
                    "c:AddTeamMemberToAccountAuraCmp",
                    {
                         "accountids": '{!concatenatedAccIds}'
                        
                        
                    },
                    "account_lookup",
                    function()
                    {
                        $A.eventService.addHandler({ "event": "c:RedirectAccountListViewEvent", "handler" : visualForceFunction});
