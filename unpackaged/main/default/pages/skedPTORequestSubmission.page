<apex:page controller="skedPtoRequestController" sidebar="false" title="Availability Requests" standardstylesheets="false" showheader="false" doctype="html-5.0">
<html lang="en" style="height: 100%">
<head>
  <meta charset="UTF-8" />
  <title>PTO Request Submission</title>
  <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1" />

  <!-- Styles -->
  <link rel="stylesheet" href="{!URLFOR($Resource.sked_HLT_Vendors, '/slds/styles/salesforce-lightning-design-system.min.css')}" />
  <link rel="stylesheet" href="{!URLFOR($Resource.sked_HLT_Dist, '/styles/availability-request-submission.css')}" />

  <style>
    .skiplink {
      position: absolute;
    }
    .noSidebarCell, .sidebarCell .fixed {
      padding: 0;
    }
    .globalHeaderBar {
      margin: 0;
    }
  </style>
</head>

<body style="margin: 0; padding: 0; height: 100%">
  <!-- app: availability-request-submission -->
  <div ng-app="hltApp" class="sked-slds ng-cloak" ng-init="loading" style="height: 100%">
    <!-- loading spinner -->
    <div class="slds-spinner_container fixed-spinner" ng-show="loading">
      <div role="status" class="slds-spinner slds-spinner--medium">
      <span class="slds-assistive-text">Loading</span>
      <div class="slds-spinner__dot-a"></div>
      <div class="slds-spinner__dot-b"></div>
      </div>
    </div>

    <!-- main component -->
    <availability-request-submission resource-id="'{!resourceId}'"></availability-request-submission>
  </div>

  <!-- jquery -->
  <script src="{!URLFOR($Resource.sked_HLT_Vendors, '/jquery/jquery-3.1.1.min.js')}"></script>
  <!-- angularjs -->
  <script src="{!URLFOR($Resource.sked_HLT_Vendors, '/angularjs/angular.min.js')}"></script>
  <script src="{!URLFOR($Resource.sked_HLT_Vendors, '/angularjs/angular-sanitize.min.js')}"></script>
  <script src="{!URLFOR($Resource.sked_HLT_Vendors, '/lodash.min.js')}"></script>

  <!-- angular google chart -->
  <script src="{!URLFOR($Resource.sked_HLT_Vendors, '/ng-google-chart.min.js')}"></script>

  <!-- app -->
  <script src="{!URLFOR($Resource.sked_HLT_Dist, '/scripts/hlt-ars.js')}"></script>

  <!-- app: bootstrap -->
  <script>
    (function (angular, apiController) {
      angular.module('skedApp.core')
      .config([
        'apiProvider',
        'envProvider',
        'langProvider',
        function (apiProvider, envProvider, langProvider) {
          apiProvider.setController(apiController);
          apiProvider.setRemotingConfiguration({
            escape: false
          });
          apiProvider.enableDebug();
          envProvider.setVariables({
            RESOURCE_PATH: "{!URLFOR($Resource.sked_HLT_Vendors, '/')}"
          });
        }
      ]);
    })(angular, angular.merge({}, skedPtoRequestController));
  </script>
</body>
</html> 
</apex:page>