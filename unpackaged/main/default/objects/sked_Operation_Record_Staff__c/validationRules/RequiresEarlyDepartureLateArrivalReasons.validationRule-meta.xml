<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RequiresEarlyDepartureLateArrivalReasons</fullName>
    <active>true</active>
    <errorConditionFormula>ISPICKVAL(sked_EarlyDeparture_LateArrival_Reasons__c, &#39;&#39;)
&amp;&amp; 
(
   (sked_Actual_Shift_Start__c &gt;  sked_Scheduled_Shift_Start__c) 
   || (sked_Actual_Shift_End__c &lt; sked_Scheduled_Shift_End__c)
)</errorConditionFormula>
    <errorMessage>Early Departure / Late Arrival Reasons is required.</errorMessage>
</ValidationRule>
