<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VariationAmountMustBe5MinutesIncrements</fullName>
    <active>true</active>
    <errorConditionFormula>MOD( sked_Variation_Amount__c ,5) != 0</errorConditionFormula>
