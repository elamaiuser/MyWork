<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Role_cannot_be_blank</fullName>
    <active>true</active>
    <description>Role field cannot be blank</description>
    <errorConditionFormula>IF(AND( LOWER($Label.IsMigrationEnable)  = &quot;false&quot; , ISBLANK( TEXT(Role))),true, false)</errorConditionFormula>
    <errorDisplayField>Role</errorDisplayField>
    <errorMessage>Role cannot be blank</errorMessage>
</ValidationRule>
