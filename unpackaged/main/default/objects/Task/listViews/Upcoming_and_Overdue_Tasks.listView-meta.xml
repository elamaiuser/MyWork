<?xml version="1.0" encoding="UTF-8"?>
<ListView xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Upcoming_and_Overdue_Tasks</fullName>
    <columns>SUBJECT</columns>
    <columns>WHAT_NAME</columns>
    <columns>Account_Name__c</columns>
    <columns>DUE_DATE</columns>
    <columns>STATUS</columns>
    <columns>PRIORITY</columns>
    <columns>CORE.USERS.ALIAS</columns>
    <columns>LAST_UPDATE</columns>
    <columns>UPDATEDBY_USER.ALIAS</columns>
    <filterScope>Mine</filterScope>
    <filters>
        <field>STATUS</field>
        <operation>notEqual</operation>
        <value>Completed,Cancelled</value>
    </filters>
    <filters>
        <field>DUE_DATE</field>
        <operation>lessOrEqual</operation>
        <value>NEXT_N_DAYS:14</value>
    </filters>
    <label>My Upcoming and Overdue Tasks</label>
</ListView>
