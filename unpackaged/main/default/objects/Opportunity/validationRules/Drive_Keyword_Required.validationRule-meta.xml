<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Drive_Keyword_Required</fullName>
    <active>false</active>
    <errorConditionFormula>AND( ISBLANK(Drive_Keyword__c  ) , ISPICKVAL(StageName, &quot;Closed&quot;), ISPICKVAL( Open_to_Public__c , &quot;No&quot;)  )</errorConditionFormula>
    <errorDisplayField>Drive_Keyword__c</errorDisplayField>
    <errorMessage>Drive Keyword is required if the &quot;Open To Public&quot; field value is &quot;No&quot; and stage is Closed</errorMessage>
</ValidationRule>
