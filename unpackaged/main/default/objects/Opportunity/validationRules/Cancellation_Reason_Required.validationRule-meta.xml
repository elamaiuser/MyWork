<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cancellation_Reason_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(StageName  , &#39;Cancelled&#39;) ,( ISPICKVAL( sked_Cancellation_Reason__c , &#39;&#39;) ))</errorConditionFormula>
    <errorMessage>In order to mark this opportunity stage = canceled, please select initiated by and cancellation reasons first.</errorMessage>
</ValidationRule>
