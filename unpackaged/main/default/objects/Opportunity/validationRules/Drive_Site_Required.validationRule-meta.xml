<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Drive_Site_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND( Drive_Site__c  = null, ISPICKVAL(StageName, &quot;Solicitation&quot;) )</errorConditionFormula>
    <errorDisplayField>Drive_Site__c</errorDisplayField>
    <errorMessage>Drive Site is required, if stage is solicitation.</errorMessage>
</ValidationRule>
