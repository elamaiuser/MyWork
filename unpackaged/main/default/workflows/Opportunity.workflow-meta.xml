    <rules>
        <fullName>Double Reds is Null</fullName>
        <actions>
            <name>Populate_Double_Reds_to_Zero</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>Account.Accepts_Automation2__c</field>
            <operation>equals</operation>
            <value>No</value>
        </criteriaItems>
        <description>If blood drive will not be conducting 2RBC procedures, auto-populate the Double Reds field with &quot;0.&quot;</description>
        <triggerType>onCreateOnly</triggerType>
    </rules>
    <rules>
        <fullName>Online Scheduling Enabled Default</fullName>
        <actions>
            <name>Online_Scheduling_Enabled_Default</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>Opportunity.Online_Scheduling_Enabled__c</field>
            <operation>equals</operation>
        </criteriaItems>
        <description>If Online Scheduling Enabled field is left blank when user creates the Opportunity, it should default to Yes.</description>
        <triggerType>onCreateOnly</triggerType>
    </rules>
    <rules>
        <fullName>Set Total Units to Total Opp Qty</fullName>
        <actions>
            <name>Set_Total_Oppty_Qty</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <description>When the Total Projected Procedures field is updated to a value which does not equal to Quantity field value, this rule triggers the associated field update to fire. This rule will only apply until the Drive is changed to a status of &quot;Closed.&quot;</description>
        <formula>(ISPICKVAL(StageName,&quot;Draft&quot;)  ||  ISPICKVAL(StageName,&quot;Planning&quot;)  ||  ISPICKVAL(StageName,&quot;Initiate Commitment&quot;)  ||  ISPICKVAL(StageName,&quot;Committed&quot;)  ||  ISPICKVAL(StageName,&quot;Pending Logistics&quot;) )   &amp;&amp;   Total_Projected_Procedures__c &lt;&gt; TotalOpportunityQuantity</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Update Drive Name Field</fullName>
        <actions>
            <name>Update_Drive_Name_Field</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Update_Opp_Name</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <description>Populate Drive Name field with Account and Site Name</description>
        <formula>(ISCHANGED(Name) || ISNEW())   &amp;&amp; (Is_Template__c == true)</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Update EnableAPHWebScheduling to Check</fullName>
        <actions>
            <name>Update_Enable_APH_Web_Scheduling</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>Opportunity.Web_Scheduling_Enabled__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <description>Update when EnableWebScheduling is checked</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
