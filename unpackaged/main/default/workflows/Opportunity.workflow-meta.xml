    <fieldUpdates>
        <fullName>Set_Total_Oppty_Qty</fullName>
        <description>Updates the Quantity field to the value of the # of Whole Blood procedures plus the Double Red procedures doubled. This is because WB procedures generate 1 unit, and 2RBC procedures generate 2 units.</description>
        <field>TotalOpportunityQuantity</field>
        <formula>X2RBC_Projected_Procedures__c * 2 + WB_Projected_Procedures__c</formula>
        <name>Set Total Oppty Qty</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
