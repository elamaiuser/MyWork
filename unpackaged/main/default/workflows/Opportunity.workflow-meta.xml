    <rules>
        <fullName>Update Opportunity Name with No Site</fullName>
        <actions>
            <name>Update_Opportunity_Name_with_TBD</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <description>Populate Drive Name field with Account and &quot;TBD&quot; if there is no site selected on the opportunity.</description>
        <formula>ISBLANK( Drive_Site__c ) &amp;&amp;  (Is_Template__c == false)</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Update Opportunity Name with Site Building</fullName>
        <actions>
            <name>Update_Opportunity_Name</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <description>Populate Drive Name field with Account and Site/Building Name from the Site if a Site is selected.</description>
        <formula>NOT(ISBLANK(Drive_Site__c)  &amp;&amp;  (Is_Template__c == false) )&amp;&amp; (ISCHANGED( Name ) ||  ISCHANGED( Drive_Site__c )  ||  ISNEW())</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Update Start%2FEndTime and Direct Donors To</fullName>
        <actions>
            <name>EndTimeFieldUpdate</name>
            <type>FieldUpdate</type>
