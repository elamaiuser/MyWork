<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>55.0</apiVersion>
    <description>update Site with Region and Chapter (when site is created or updated)</description>
    <environments>Default</environments>
    <interviewLabel>updateSiteWithRegionAndChapter {!$Flow.CurrentDateTime}</interviewLabel>
    <label>updateSiteWithRegionAndChapter</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>get chapter using site collection op zip code from Chapter/Blood Region Zip Match</description>
        <name>getChapter</name>
        <label>getChapter</label>
        <locationX>812</locationX>
        <locationY>456</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>updateSite</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Zip__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.sked_Zip_Code__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Chapter_Blood_Region_Zip_Match__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>get Site collection operation of the site</description>
        <name>getSiteCollectionOperation</name>
        <label>getSiteCollectionOperation</label>
        <locationX>812</locationX>
        <locationY>336</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>getChapter</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>sked_End_Date__c</field>
            <operator>GreaterThan</operator>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </filters>
        <filters>
            <field>sked_Start_Date__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </filters>
        <filters>
            <field>sked_Site__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>sked_Site_Collection_Operation__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>update site with region and chapter</description>
        <name>updateSite</name>
        <label>updateSite</label>
        <locationX>812</locationX>
        <locationY>576</locationY>
        <inputAssignments>
            <field>sked_Chapter__c</field>
            <value>
                <elementReference>getChapter.Chapter__r.Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>sked__Region__c</field>
            <value>
                <elementReference>getSiteCollectionOperation.sked_Region__r.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>244</locationX>
        <locationY>107</locationY>
        <connector>
            <targetReference>getSiteCollectionOperation</targetReference>
        </connector>
        <filterLogic>1 OR 2</filterLogic>
        <filters>
            <field>sked_Zip_Code__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>sked_Chapter__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>sked__Location__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
