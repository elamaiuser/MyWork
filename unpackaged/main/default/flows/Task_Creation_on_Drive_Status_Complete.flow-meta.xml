    <description>This flow will be triggered whenever a DOC will get completed and create Post Drive Analysis task with a due date of drive date+4 days
Latest Modification: HRP-12700 Add Drive Date to task list</description>
    <environments>Default</environments>
    <formulas>
        <description>Assign the task to the opp&#39;s account manager if present. Else it will go straight to the opportunity owner</description>
        <name>accountManagerOrOwnerFormula</name>
        <dataType>String</dataType>
        <expression>IF({!$Record.sked_Opportunity__r.Account_Manager__c &lt;&gt; NULL}, {!$Record.sked_Opportunity__r.Account_Manager__c}, 
IF({!forDM} &lt;&gt; NULL, {!forDM},
IF({!forAS}&lt;&gt; NULL, {!forAS},
{!$Record.sked_Opportunity__r.OwnerId})))</expression>
    </formulas>
    <formulas>
        <name>DueDateTask</name>
        <dataType>Date</dataType>
        <expression>{!$Record.sked_Opportunity__r.Drive_Date__c}+4</expression>
    </formulas>
    <formulas>
        <name>forAS</name>
        <dataType>String</dataType>
        <expression>IF(ISPICKVAL({!opportunityTeamMembers.TeamMemberRole}, &#39;Account Specialist&#39;), {!opportunityTeamMembers.UserId},null)</expression>
    </formulas>
    <formulas>
        <name>forDM</name>
        <dataType>String</dataType>
        <expression>IF(ISPICKVAL({!opportunityTeamMembers.TeamMemberRole}, &#39;District Manager&#39;), {!opportunityTeamMembers.UserId},null)</expression>
    </formulas>
