<aura:component implements="force:lightningQuickActionWithoutHeader,force:hasRecordId" controller="UpdateNationalNameStatusController">
	<aura:attribute name="message" type="String" default="Processing.."/>
	<aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <div class="slds-modal__content slds-p-around_medium slds-p-bottom_xx-large">
       <p>{!v.message}</p>
    </div>
    <div class="attach-to-bottom" style="margin-top: 95px">
        <lightning:button variant="brand" label="Finish" title="Finish" onclick="{! c.closePopup }" class="slds-clearfix slds-float_right slds-m-top_xx-large"/>
    </div>
</aura:component>