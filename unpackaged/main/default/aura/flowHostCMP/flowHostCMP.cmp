<aura:component >
    <aura:attribute name="selectedOpportunity" type="Opportunity[]" />
    <aura:attribute name="selectedAccountId" type="String" />
    <aura:handler name="init" value="{!this}" action="{!c.init}"/>
    <section role="dialog" tabindex="-1" class="slds-modal slds-fade-in-open slds-modal_small" aria-labelledby="modal-heading-01" aria-modal="true" aria-describedby="modal-content-id-1">
        <div class="slds-modal__container">
            <header class="slds-modal__header">
                <button class="slds-button slds-button_icon slds-modal__close slds-button_icon-inverse" title="Close">
                    <lightning:buttonIcon iconName="utility:close" size="large" variant="bare" onclick="{! c.handleClose }" alternativeText="Close" title="Close" />
                    <span class="slds-assistive-text">Close</span>
                </button>
                <h2 id="modal-heading-01" class="slds-modal__title slds-hyphenate">Mass Update Opportunity</h2>
            </header>
            <lightning:flow aura:id="flowData" onstatuschange="{!c.handleStatusChange}" class="slds-modal__content slds-p-around_medium" />
        </div>
    </section> 
    <div class="slds-backdrop slds-backdrop_open" style="z-index: -1"></div>
</aura:component>