<aura:component controller="OpportunityLinkedDriveController" implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction" access="global" >
    
    
    <!-- attributes -->
    <aura:attribute name="columns" type="List" default="[]"/>
    <aura:attribute name="data" type="List" default="[]"/>
    <aura:attribute name="dataTableSchema" type="Object"/>
    <aura:attribute name="keyField" type="String" default="id"/>
    <aura:attribute name="initialRows" type="Integer" default="5"/>
    <aura:attribute name="selectedRowsCount" type="Integer" default="0"/>
    <aura:attribute name="enableInfiniteLoading" type="Boolean" default="true"/>
    <aura:attribute name="rowsToLoad" type="Integer" default="50"/>
    <aura:attribute name="loadMoreOffset" type="Integer" default="20"/>
    <aura:attribute name="totalNumberOfRows" type="Integer" default="300"/>
    <aura:attribute name="loadMoreStatus" type="String" default=""/>
    <aura:attribute name="selectedSingleDriveRecord" type="String" default=""/>
    <aura:attribute name="isLinkedDriveExist" type="Boolean" default="false"/>
    <aura:attribute name="linkedSingleDriveRecordId" type="String" default=""/>
    <aura:attribute name="oppRecordId1" type="String" default=""/>
    <aura:attribute name="oppRecordId2" type="String" default=""/>
    
    <aura:attribute name="opportunityRecordFields" type="Object"/>
    
    <!-- Imports 
    <aura:import library="lightningcomponentdemo:mockdataFaker" property="mockdataLibrary"/>-->
    <force:recordData aura:id="opportunityRecordData"
                      recordId="{!v.recordId}" 
                      fields="Name,Linked_Opportunity_Drives__c"
                      targetFields="{!v.opportunityRecordFields}"
                      recordUpdated="{!c.saRecordUpdated}" />
    <!-- handlers-->
    <aura:handler name="init" value="{! this }" action="{! c.init }"/>
    
    
    <div class="slds-is-relative">
        <!-- toolbox -->
        <div class="slds-m-vertical_small">
            <aura:if isTrue="{!v.isLinkedDriveExist}">
                
                <div style="background-color: #04844b;    color: white;border-radius: 20px;">
                    <lightning:layout horizontalAlign="space">
                        <lightning:layoutItem padding="around-small" flexibility="auto">
                            
                            <lightning:formattedText value="This drive is linked and part of Single day Drive" />
                            
                        </lightning:layoutItem>
                    </lightning:layout >

                </div>

                
            </aura:if>
            <!--<h1 class="slds-m-vertical_small">Total Rows: {! v.data.length }</h1>
            <h1 class="slds-m-vertical_small">Selected Rows: {! v.selectedRowsCount }</h1>-->
            <div style="text-align-last: center;    margin-top: 10px;">
                <lightning:button variant="brand" label="Link Single Drive" title="Link Single Drive" onclick="{! c.handleClick }" />
                <lightning:button variant="destructive" label="De-Link Single Drive" title="De-Link Single Drive" onclick="{! c.handleDeLink }" />
            </div>
            
            <!--<div class="input-group">
                <lightning:input type="toggle" label="Enable Infinite Loading" name="inputInfiniteLoading" checked="{! v.enableInfiniteLoading }"/>
                <lightning:input type="number" label="Rows To Load" name="inputRowsToLoad" value="{! v.rowsToLoad }"/>
                <lightning:input type="number" label="Load More Threshold in px" name="inputloadMoreOffset" value="{! v.loadMoreOffset }"/>
            </div>-->
            
        </div>
        
        <!-- the container element determine the height of the datatable -->
        <div style="height: 300px">
            <lightning:datatable
                                 columns="{! v.columns }"
                                 data="{! v.data }"
                                 keyField="{! v.keyField }"
                                 showRowNumberColumn="true"
                                 onrowselection="{! c.getSelectedRows }"
                                 enableInfiniteLoading="{! v.enableInfiniteLoading }"
                                 loadMoreOffset="{! v.loadMoreOffset }"
                                 
                                 />
        </div>
        {! v.loadMoreStatus }
    </div>
</aura:component>

<!--onloadmore="{! c.loadMoreData }"-->