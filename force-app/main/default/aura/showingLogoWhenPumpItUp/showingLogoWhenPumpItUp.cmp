<aura:component implements="flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId" access="global" >
    <aura:attribute name="record" type="Object"/>
    <aura:attribute name="simpleRecord" type="Object"/>
    <aura:attribute name="recordError" type="String"/>
    
    <force:recordData aura:id="recordLoader"
      layoutType="FULL"
      fields="IsPumpedItUpCurrent__c,IsPremierCurrent__c,Is_Hospital_Contract_Partner__c"
      recordId="{!v.recordId}"
      targetFields="{!v.simpleRecord}"
      targetError="{!v.recordError}"
     />
   
    
    <div class="slds-grid slds-gutters">
         <aura:if isTrue="{!v.simpleRecord.IsPumpedItUpCurrent__c}">
        <div class="slds-align_absolute-center" style="width: 15%;height: 40%;">
            <img src="{!$Resource.ShowingLogowhenPumpItUp}" />
        </div>
        </aura:if>
        <aura:if isTrue="{!v.simpleRecord.IsPremierCurrent__c}">
        <div class="slds-align_absolute-center" style="width: 15%;height: 40%;">
            <img src="{!$Resource.ShowingLogowhenPremierCurrent}" />
        </div>
        </aura:if>
        <aura:if isTrue="{!v.simpleRecord.Is_Hospital_Contract_Partner__c}">
        <div class="slds-align_absolute-center" style="width: 15%;height: 40%;">
            <img src="{!$Resource.hospitalContractPartnerBadgeLogo}" />
        </div>
        </aura:if>
    </div>
</aura:component>

<!-- class="slds-box  slds-align_absolute-center"max-width:100%;height:auto;  -->