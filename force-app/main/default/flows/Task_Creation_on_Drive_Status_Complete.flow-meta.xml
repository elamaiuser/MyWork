    <description>HRP-13426</description>
    <environments>Default</environments>
    <formulas>
        <description>Assign the task to the opp&apos;s account manager if present. Else it will go straight to the opportunity owner</description>
        <name>accountManagerOrOwnerFormula</name>
        <dataType>String</dataType>
        <expression>IF({!$Record.sked_Opportunity__r.Account_Manager__c &lt;&gt; NULL}, {!$Record.sked_Opportunity__r.Account_Manager__c}, 
IF({!forDM} &lt;&gt; NULL, {!forDM},
IF({!forAS}&lt;&gt; NULL, {!forAS},
{!$Record.sked_Opportunity__r.OwnerId})))</expression>
    </formulas>
    <formulas>
        <name>DueDateTask</name>
        <dataType>Date</dataType>
        <expression>{!$Record.sked_Opportunity__r.Drive_Date__c}+4</expression>
    </formulas>
    <formulas>
        <name>forAS</name>
        <dataType>String</dataType>
        <expression>IF(ISPICKVAL({!opportunityTeamMembers.TeamMemberRole}, &apos;Account Specialist&apos;), {!opportunityTeamMembers.UserId},null)</expression>
    </formulas>
    <formulas>
        <name>forDM</name>
        <dataType>String</dataType>
        <expression>IF(ISPICKVAL({!opportunityTeamMembers.TeamMemberRole}, &apos;District Manager&apos;), {!opportunityTeamMembers.UserId},null)</expression>
    </formulas>
