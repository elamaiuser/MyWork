<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <apiVersion>49.0</apiVersion>
    <assignments>
        <description>Here Set Account Effective date value to effectiveDate variable [ Date type variable ]</description>
        <name>AccountEffectiveDateAssignment</name>
        <label>AccountEffectiveDateAssignment</label>
        <locationX>334</locationX>
        <locationY>287</locationY>
        <assignmentItems>
            <assignToReference>EffectiveDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_current_account.Defunct_Effective_Date__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>GetEarliestFutureDriveDateOpp</targetReference>
        </connector>
    </assignments>
    <choices>
        <name>Defunct_ch</name>
        <choiceText>&lt;span style=&quot;background-color: rgb(255, 255, 255); font-size: 11.36px; font-family: Helvetica; color: rgb(0, 0, 0);&quot;&gt;Defunct&lt;/span&gt;</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Defunct</stringValue>
        </value>
    </choices>
    <choices>
        <name>Lost_ch</name>
        <choiceText>Lost</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Lost</stringValue>
        </value>
    </choices>
    <decisions>
        <description>Search future Drives ( here Drives means Opportunities not Sked_Drives )</description>
        <name>SearchResultForFutureDrives</name>
        <label>SearchResultForFutureDrives</label>
        <locationX>595</locationX>
        <locationY>377</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>FutureDriveFound</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetEarliestFutureDriveDateOpp</leftValueReference>
                <operator>NotEqualTo</operator>
            </conditions>
            <connector>
                <targetReference>Future_Dives_Present</targetReference>
            </connector>
            <label>FutureDriveFound</label>
        </rules>
        <rules>
            <name>FutureDriveNotFound</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>FutureDriveFound</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_account_lost_Defunct</targetReference>
            </connector>
            <label>FutureDriveNotFound</label>
        </rules>
    </decisions>
    <description>Added faultMessage Screen</description>
    <dynamicChoiceSets>
        <name>Lost_Reason</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true" />
        <object xsi:nil="true" />
        <picklistField>Lost_Reason__c</picklistField>
        <picklistObject>Account</picklistObject>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <interviewLabel>Lost Account {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lost Account</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
