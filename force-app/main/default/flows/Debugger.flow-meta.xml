<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>50.0</apiVersion>
    <formulas>
        <name>varCeiling</name>
        <dataType>Number</dataType>
        <expression>CEILING((85)/5)*2</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>varDriveDateMinus180</name>
        <dataType>Date</dataType>
        <expression>{!Drive_Date}-180</expression>
    </formulas>
    <formulas>
        <description>CASE(MOD({!Drive_Date}-TODAY(), 7),  
0, 9,
6, 9, 
0)</description>
        <name>varDriveDateMinus85</name>
        <dataType>Date</dataType>
        <expression>({!Drive_Date} - 85)</expression>
    </formulas>
    <formulas>
        <name>varModuloFor180Days</name>
        <dataType>Number</dataType>
        <expression>MOD(({!Drive_Date} - 180) - DATE(1900, 1, 6), 7)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>varModuloFor85Days</name>
        <dataType>Number</dataType>
        <expression>MOD(({!Drive_Date} - 85) - DATE(1900, 1, 6), 7)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>varNewCloseDateAuto</name>
        <dataType>Date</dataType>
        <expression>CASE(
MOD(({!Drive_Date} - 85) - DATE(1900, 1, 6), 7),
0, (({!Drive_Date}  - 85) - 1),
1, (({!Drive_Date} - 85) + 1),
{!Drive_Date}-85)</expression>
    </formulas>
    <formulas>
        <name>varNewDate</name>
        <dataType>Date</dataType>
        <expression>{!Drive_Date} + 85</expression>
    </formulas>
    <formulas>
        <name>varNewTargetDateAuto</name>
        <dataType>Date</dataType>
        <expression>CASE(
MOD(({!Drive_Date} - 180) - DATE(1900, 1, 6), 7),
0, (({!Drive_Date}  - 180) - 1),
1, (({!Drive_Date} - 180) + 1),
{!Drive_Date}-180)</expression>
    </formulas>
    <formulas>
        <name>varWeekDay</name>
        <dataType>Number</dataType>
        <expression>Weekday({!Drive_Date})</expression>
        <scale>0</scale>
    </formulas>
