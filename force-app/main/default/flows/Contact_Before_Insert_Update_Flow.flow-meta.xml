    <formulas>
        <name>CurrentPrimaryPhone</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE(
  IF(
    ISPICKVAL({!$Record.Primary_Phone__c}, &quot;Home Phone&quot;),   {!$Record.HomePhone},
    IF(
      ISPICKVAL({!$Record.Primary_Phone__c}, &quot;Mobile Phone&quot;), {!$Record.MobilePhone},
      IF(
        ISPICKVAL({!$Record.Primary_Phone__c}, &quot;Work Phone&quot;), {!$Record.OtherPhone},
        &quot;&quot;
      )
    )
  ),
  {!$Record.Phone}
)</expression>
