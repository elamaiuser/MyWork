    <decisions>
        <name>Send_Bell_Notification_to_Owner</name>
        <label>Send Bell Notification to Owner</label>
        <locationX>248</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>DM_select_approval_status_Yes</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>FALSE_Send Bell Notification to Owner</defaultConnectorLabel>
        <rules>
            <name>TRUE_Send_Bell_Notification_to_Owner</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Is_New_Or_Changed_Owner</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Subject</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Task_Subject_Marketing_Exception</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Notify_Task_Owner</targetReference>
            </connector>
            <label>TRUE_Send Bell Notification to Owner</label>
        </rules>
    </decisions>
