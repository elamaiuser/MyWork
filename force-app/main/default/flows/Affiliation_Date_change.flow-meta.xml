    <decisions>
        <name>Check_Within_Range</name>
        <label>Check Within Range</label>
        <locationX>837</locationX>
        <locationY>684</locationY>
        <defaultConnector>
            <targetReference>Assignment_D_Afiliation_not_met_filtered_condition</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Eligible_to_delete</name>
            <conditionLogic>(1 AND 2 AND 5 AND 6) AND (3 OR 4)</conditionLogic>
            <conditions>
                <leftValueReference>Iterating_Drive_Affiliation.Blood_Drive_Opportunity__r.Drive_Date__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>Current_Affiliation.Booking_Start_Date__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Iterating_Drive_Affiliation.Blood_Drive_Opportunity__r.Drive_Date__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>Current_Affiliation.Booking_End_Date__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Iterating_Drive_Affiliation.Blood_Drive_Opportunity__r.Drive_Date__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>Booking_Start_Date</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Iterating_Drive_Affiliation.Blood_Drive_Opportunity__r.Drive_Date__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>Booking_End_Date</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Current_Affiliation.Booking_Start_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Current_Affiliation.Booking_End_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment_filtered_to_collection</targetReference>
            </connector>
            <label>Eligible to delete</label>
        </rules>
        <rules>
            <name>Eligible_to_delete_start</name>
            <conditionLogic>(1 AND 2 AND 3) AND (4 OR 5)</conditionLogic>
            <conditions>
                <leftValueReference>Current_Affiliation.Booking_Start_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Current_Affiliation.Booking_End_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Iterating_Drive_Affiliation.Blood_Drive_Opportunity__r.Drive_Date__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>Current_Affiliation.Booking_Start_Date__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Iterating_Drive_Affiliation.Blood_Drive_Opportunity__r.Drive_Date__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>Booking_Start_Date</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Iterating_Drive_Affiliation.Blood_Drive_Opportunity__r.Drive_Date__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>Booking_End_Date</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment_filtered_to_collection</targetReference>
            </connector>
            <label>Eligible to delete start</label>
        </rules>
        <rules>
            <name>Eligible_to_delete_End</name>
            <conditionLogic>(1 AND 2 AND 3) AND(4 OR 5)</conditionLogic>
            <conditions>
                <leftValueReference>Current_Affiliation.Booking_Start_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Current_Affiliation.Booking_End_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Iterating_Drive_Affiliation.Blood_Drive_Opportunity__r.Drive_Date__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>Current_Affiliation.Booking_End_Date__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Iterating_Drive_Affiliation.Blood_Drive_Opportunity__r.Drive_Date__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>Booking_Start_Date</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Iterating_Drive_Affiliation.Blood_Drive_Opportunity__r.Drive_Date__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>Booking_End_Date</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment_filtered_to_collection</targetReference>
            </connector>
            <label>Eligible to delete End</label>
        </rules>
