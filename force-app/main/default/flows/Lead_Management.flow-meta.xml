    <description>HRP-14505 Converted, refactored and merged Update Lead to Market Manager (WF), Lead Status TimeStamp (PB), and Aggregate TimeStamp (PB) to Flow.</description>
    <environments>Default</environments>
    <formulas>
        <name>ContactedStatusAgrDays</name>
        <dataType>Number</dataType>
        <expression>IF( ISBLANK({!$Record__Prior.Contacted_Status_Agr_Days__c}), 0, {!$Record__Prior.Contacted_Status_Agr_Days__c}) + 
(Now() - {!$Record.Lead_Status_CONTACTED__c})</expression>
        <scale>14</scale>
    </formulas>
    <formulas>
        <name>CurrentDateTime</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <formulas>
        <name>NewStatusAgrDays</name>
        <dataType>Number</dataType>
        <expression>IF( ISBLANK({!$Record__Prior.New_Status_Agr_Days__c}), 0, {!$Record__Prior.New_Status_Agr_Days__c}) + 
(Now() - {!$Record.Lead_Status_NEW__c})</expression>
        <scale>14</scale>
    </formulas>
    <formulas>
        <name>QualifiedStatusAgrDays</name>
        <dataType>Number</dataType>
        <expression>IF( ISBLANK({!$Record__Prior.Qualified_Status_Agr_Days__c}), 0, {!$Record__Prior.Qualified_Status_Agr_Days__c}) + 
(Now() - {!$Record.Lead_Status_QUALIFIED__c})</expression>
        <scale>14</scale>
    </formulas>
    <formulas>
        <name>UnqualifiedStatusAgrDays</name>
        <dataType>Number</dataType>
        <expression>IF( ISBLANK({!$Record__Prior.Unqualified_Status_Agr_Days__c}), 0, {!$Record__Prior.Unqualified_Status_Agr_Days__c}) + 
(Now() - {!$Record.Lead_Status_UNQUALIFIED__c})</expression>
        <scale>14</scale>
    </formulas>
