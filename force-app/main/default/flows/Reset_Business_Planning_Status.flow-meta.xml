<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Call the batch to blank out business plan related fields for all the accounts where the checkbox is checked</description>
        <name>Call_Reset_Business_Plan_Status_Batch</name>
        <label>Call Reset Business Plan Status Batch</label>
        <locationX>50</locationX>
        <locationY>1298</locationY>
        <actionName>ResetBusinessPlanningStatusHelper</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <inputParameters>
            <name>accListToBeUpdated</name>
            <value>
                <elementReference>accountsToBeUpdatedList</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>profileName</name>
            <value>
                <elementReference>varProfileName</elementReference>
            </value>
        </inputParameters>
        <nameSegment>ResetBusinessPlanningStatusHelper</nameSegment>
    </actionCalls>
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_allowed_profiles_to_the_collection_variable</name>
        <label>Assign allowed profiles to the collection variable</label>
        <locationX>468</locationX>
        <locationY>566</locationY>
        <assignmentItems>
            <assignToReference>allowedProfileNames</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_through_metadata_record.Allowed_Profiles__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_through_metadata_record</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Get_total_count_of_the_account_list</name>
        <label>Get total count of the account list</label>
        <locationX>182</locationX>
        <locationY>974</locationY>
        <assignmentItems>
            <assignToReference>totalCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>accountsToBeUpdatedList</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Is_Any_such_accounts_present</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Is_Any_such_accounts_present</name>
        <label>Is Any such accounts present?</label>
        <locationX>182</locationX>
        <locationY>1082</locationY>
        <defaultConnector>
            <targetReference>No_Accounts_Found_Msg_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Present</defaultConnectorLabel>
        <rules>
            <name>Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>totalCount</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Accounts_Found_Msg_Screen</targetReference>
            </connector>
            <label>Present</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_the_User_Authorized</name>
        <label>Is User Authorized</label>
        <locationX>380</locationX>
        <locationY>758</locationY>
        <defaultConnector>
            <targetReference>Error_Msg_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>User_is_authorized</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isProfileFoundOut</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Account_Records</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>This flow will be triggered after clicking &#39;Reset Business Planning Status&#39; button from the Account List view. This flow is for HRP-9520</description>
    <environments>Default</environments>
    <formulas>
        <name>isProfileFoundOut</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS({!allowedProfileNames}, {!varProfileName})</expression>
    </formulas>
    <interviewLabel>Reset Business Planning Status {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Reset Business Planning Status</label>
    <loops>
        <name>Loop_through_metadata_record</name>
        <label>Loop through metadata record</label>
        <locationX>380</locationX>
        <locationY>458</locationY>
        <collectionReference>metadataRecord</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_allowed_profiles_to_the_collection_variable</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Is_the_User_Authorized</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <description>Get all those accounts where Business Planning Completed checkbox is true, no other filters needed</description>
        <name>Get_Account_Records</name>
        <label>Get Account Records</label>
        <locationX>182</locationX>
        <locationY>866</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_total_count_of_the_account_list</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Business_Planning_Completed__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Account</object>
        <outputReference>accountsToBeUpdatedList</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Business_Planning_Completed__c</queriedFields>
        <queriedFields>Business_Planning_Completed_By__c</queriedFields>
        <queriedFields>Business_Planning_Completed_Date__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <description>Get the logged-In user&#39;s profile info</description>
        <name>Get_Logged_In_User_Info</name>
        <label>Get Logged-In User&#39;s Info</label>
        <locationX>380</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Logged_In_User_s_Profile</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </filters>
        <object>User</object>
        <outputAssignments>
            <assignToReference>varProfileId</assignToReference>
            <field>ProfileId</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <name>Get_Logged_In_User_s_Profile</name>
        <label>Get Logged-In User&#39;s Profile</label>
        <locationX>380</locationX>
        <locationY>242</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Reset_Planning_Metadata_Records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varProfileId</elementReference>
            </value>
        </filters>
        <object>Profile</object>
        <outputAssignments>
            <assignToReference>varProfileName</assignToReference>
            <field>Name</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <name>Get_Reset_Planning_Metadata_Records</name>
        <label>Get Reset Planning Metadata Records</label>
        <locationX>380</locationX>
        <locationY>350</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_through_metadata_record</targetReference>
        </connector>
        <object>Reset_Business_Planning_Setting__mdt</object>
        <outputReference>metadataRecord</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Allowed_Profiles__c</queriedFields>
