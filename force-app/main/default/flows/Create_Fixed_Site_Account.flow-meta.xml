        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_User_is_DRD_profile</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>DRD Manager</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>DRD Profile</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>DRD_Error_Screen</targetReference>
            </connector>
            <label>If User is DRD profile</label>
        </rules>
    </decisions>
