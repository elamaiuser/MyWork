        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Output_to_True</name>
        <label>Set Output to True</label>
        <locationX>905</locationX>
        <locationY>192</locationY>
        <assignmentItems>
            <assignToReference>varIs56DayRuleViolated</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varCountOfMatchingRecords</assignToReference>
            <operator>AssignCount</operator>
