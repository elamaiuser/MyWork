            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>X56_Days_Rule_Violating_Records_Found</name>
        <label>56 Days Rule Violating Records Found</label>
        <locationX>594</locationX>
        <locationY>188</locationY>
        <defaultConnector>
            <targetReference>Set_Output_to_False</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Violating Records Not Found</defaultConnectorLabel>
        <rules>
            <name>Violating_Records_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>colMatchingOpportunityRecords</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Output_to_True</targetReference>
            </connector>
            <label>Violating Records Found</label>
        </rules>
    </decisions>
    <formulas>
        <name>var56DaysBack</name>
        <dataType>Date</dataType>
        <expression>{!varIncomingDriveDate} - 56</expression>
    </formulas>
    <formulas>
        <name>var56DaysForward</name>
        <dataType>Date</dataType>
        <expression>{!varIncomingDriveDate} + 56</expression>
    </formulas>
    <interviewLabel>Opportunity 56 Day Check {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity 56 Day Interval Violation Check</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Opportunity_Record</name>
        <label>Get Opportunity Record</label>
        <locationX>405</locationX>
        <locationY>187</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>X56_Days_Rule_Violating_Records_Found</targetReference>
        </connector>
        <filterLogic>1 AND 2 AND 3 AND (4 AND 5)</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varIncomingAccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>StageName</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Cancelled</stringValue>
            </value>
        </filters>
        <filters>
            <field>RecordTypeId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varRecordTypeId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Drive_Date__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>var56DaysBack</elementReference>
            </value>
        </filters>
        <filters>
            <field>Drive_Date__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>var56DaysForward</elementReference>
            </value>
        </filters>
        <object>Opportunity</object>
        <outputReference>colMatchingOpportunityRecords</outputReference>
        <queriedFields>Id</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_RecordType_for_Mobile</name>
        <label>Get RecordType for Mobile</label>
        <locationX>176</locationX>
