    <formulas>
        <name>forAppendSemicolonToSelectedRoles</name>
        <dataType>String</dataType>
        <expression>{!varSelectedRoles}+&apos;;&apos;</expression>
    </formulas>
    <formulas>
        <name>forCheckIfBPLRoleIsSelected</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS({!varSelectedRoles},{!varBloodProgramLeaderRole})</expression>
    </formulas>
    <formulas>
        <name>forGetLeftRoleOfMultiPicklistValue</name>
        <dataType>String</dataType>
        <expression>LEFT({!varAdjustedRoles},FIND(&quot;;&quot;,{!varAdjustedRoles})-1)</expression>
    </formulas>
    <formulas>
        <name>forRemoveBPLRoleIfExist</name>
        <dataType>String</dataType>
        <expression>IF({!varAccountServiceRoleId}&lt;&gt; null, SUBSTITUTE(SUBSTITUTE({!forAppendSemicolonToSelectedRoles}, &apos;Blood Program Leader;&apos;, null),{!varBloodProgramLeaderRole}, &apos;&apos;), {!forAppendSemicolonToSelectedRoles})</expression>
    </formulas>
    <formulas>
        <name>forRemoveParsedRoleOfMultiPicklistValue</name>
        <dataType>String</dataType>
        <expression>TRIM((RIGHT({!varAdjustedRoles},LEN({!varAdjustedRoles})-FIND(&quot;;&quot;,{!varAdjustedRoles}))))</expression>
    </formulas>
    <formulas>
        <name>forSizeOfRemoveBPLRoleIfExist</name>
        <dataType>Number</dataType>
        <expression>IF({!forRemoveBPLRoleIfExist}=null,0,1)</expression>
        <scale>0</scale>
    </formulas>
