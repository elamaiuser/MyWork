    <decisions>
        <name>Check_all_the_multiselect_picklist_roles_are_parsed</name>
        <label>Check all the multiselect picklist roles are parsed</label>
        <locationX>182</locationX>
        <locationY>974</locationY>
        <defaultConnectorLabel>No Roles</defaultConnectorLabel>
        <rules>
            <name>Is_Parsed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varAdjustedRoles</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varRoleSize</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>Assign_the_multiselect_picklist_role_values_to_the_collection_variable</targetReference>
            </connector>
            <label>Not Parsed &amp; Had Roles</label>
        </rules>
        <rules>
            <name>Parsed_Had_Roles</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varAdjustedRoles</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varRoleSize</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_through_the_Role_Collection_Variable</targetReference>
            </connector>
            <label>Parsed &amp; Had Roles</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_If_BPL_is_selected_and_all_ready_exist</name>
        <label>Check If BPL is selected and already exist</label>
        <locationX>182</locationX>
        <locationY>458</locationY>
        <defaultConnector>
            <targetReference>Assign_the_adjusted_roles_and_the_size_of_the_roles_to_the_variables</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>BPL Not exist</defaultConnectorLabel>
        <rules>
            <name>BPL_is_selected_and_already_exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varIsBPLSelected</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varAccountServiceRoleId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Show_Warning_Message</targetReference>
            </connector>
            <label>BPL is selected and already exist</label>
        </rules>
    </decisions>
