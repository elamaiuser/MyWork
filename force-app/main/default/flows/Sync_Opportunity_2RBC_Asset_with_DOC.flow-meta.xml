        <name>is2RBCAssetMismatch</name>
        <dataType>Boolean</dataType>
        <expression>IF(
  ISBLANK({!Get_Related_DOC.sked_Number_of_2RBC_Assets__c}) 
  &amp;&amp; 
  ISBLANK({!Get_Related_DOC.sked_Opportunity__r.Number_of_2RBC_Assets__c}),
  false,
  IF(
    ISBLANK({!Get_Related_DOC.sked_Number_of_2RBC_Assets__c}) 
    || 
    ISBLANK({!Get_Related_DOC.sked_Opportunity__r.Number_of_2RBC_Assets__c}),
    true,
    {!Get_Related_DOC.sked_Number_of_2RBC_Assets__c} &lt;&gt; {!Get_Related_DOC.sked_Opportunity__r.Number_of_2RBC_Assets__c}
  )
)</expression>
