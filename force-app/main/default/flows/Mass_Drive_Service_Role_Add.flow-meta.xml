    <description>HRP-8964</description>
    <dynamicChoiceSets>
        <name>DriveServiceRoleChoiceSet</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>Role</picklistField>
        <picklistObject>OpportunityContactRole</picklistObject>
        <sortOrder>Asc</sortOrder>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>forAppendSemicolonToSelectedRoles</name>
        <dataType>String</dataType>
        <expression>{!varSelectedRoles}+&apos;;&apos;</expression>
    </formulas>
    <formulas>
        <name>forCheckAfterHoursContact</name>
        <dataType>Boolean</dataType>
        <expression>ISBLANK({!varContactAfterHours})</expression>
    </formulas>
    <formulas>
        <name>forCheckCallListGenerate</name>
        <dataType>Boolean</dataType>
        <expression>{!varDriveDate}-TODAY()&lt;=32</expression>
    </formulas>
    <formulas>
        <name>forCheckIfAfterHoursContactRoleIsSelected</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS({!varSelectedRoles},{!varAfterHoursContactRole})</expression>
    </formulas>
    <formulas>
        <name>forCheckIfCallListRecipientIsSelected</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS({!varSelectedRoles},{!varCallListRecipientRole})</expression>
    </formulas>
    <formulas>
        <name>forCheckIfPrimaryContactRoleIsSelected</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS({!varSelectedRoles},{!varPrimaryContactRole})</expression>
    </formulas>
    <formulas>
        <name>forGetLeftRoleOfMultiPicklistValue</name>
        <dataType>String</dataType>
        <expression>LEFT({!varAdjustedRoles},FIND(&quot;;&quot;,{!varAdjustedRoles})-1)</expression>
    </formulas>
    <formulas>
        <name>forRemoveAfterHoursContactRoleIfSelected</name>
        <dataType>String</dataType>
        <expression>IF({!forCheckAfterHoursContact}, SUBSTITUTE(SUBSTITUTE({!varAdjustedPrimaryContactRole}, &apos;After Hours Contact;&apos;, null),&apos;After Hours Contact&apos;, &apos;&apos;), {!varAdjustedPrimaryContactRole})</expression>
    </formulas>
    <formulas>
        <name>forRemoveCallListRecipientRoleIfSelected</name>
        <dataType>String</dataType>
        <expression>IF({!forCheckCallListGenerate}, SUBSTITUTE(SUBSTITUTE({!varAdjustedAfterHoursContactRole}, &apos;Call List Recipient;&apos;, null),&apos;Call List Recipient&apos;, &apos;&apos;), {!varAdjustedAfterHoursContactRole})</expression>
    </formulas>
    <formulas>
        <name>forRemoveParsedRoleOfMultiPicklistValue</name>
        <dataType>String</dataType>
        <expression>TRIM((RIGHT({!varAdjustedRoles},LEN({!varAdjustedRoles})-FIND(&quot;;&quot;,{!varAdjustedRoles}))))</expression>
    </formulas>
    <formulas>
        <name>forRemovePrimaryContactRoleIfExist</name>
        <dataType>String</dataType>
        <expression>IF({!varOpportunityContactRoleId}&lt;&gt; null, SUBSTITUTE(SUBSTITUTE({!forAppendSemicolonToSelectedRoles}, &apos;Primary Contact;&apos;, null),&apos;Primary Contact&apos;, &apos;&apos;), {!forAppendSemicolonToSelectedRoles})</expression>
    </formulas>
    <formulas>
        <name>forSizeOfRemoveAdjustedRoles</name>
        <dataType>Number</dataType>
        <expression>IF({!varAdjustedRoles}=null,0,1)</expression>
        <scale>0</scale>
    </formulas>
