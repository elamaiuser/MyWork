<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <rules>
        <fullName>Capitalize National Name Field</fullName>
        <actions>
            <name>Capitalize_National_Name_Field</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <description>Capitalizes all letters in the Account &quot;National_Name__c&quot; field for new and modified accounts.</description>
        <formula>ISNEW() || ISCHANGED(National_Name__c)</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Use this as mailing address automation</fullName>
        <actions>
            <name>Update_Mailing_City</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Update_Mailing_Country</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Update_Mailing_Country_Code</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Update_Mailing_State</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Update_Mailing_Street</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Update_Mailing_Zip</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>Account.Use_this_as_mailing_address__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <description>If the Use this as mailing address checkbox is checked, all fields on the Mailing Address (ShippingAddress)  should populate with the Business Address (BillingAddress) field values.</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
</Workflow>
