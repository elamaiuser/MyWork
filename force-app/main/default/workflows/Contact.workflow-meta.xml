<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <rules>
        <fullName>Do Not Contact Reasons Equals to Deceased</fullName>
        <actions>
            <name>Active_Inactive_is_false</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>Contact.Do_Not_Contact_Reason__c</field>
            <operation>equals</operation>
            <value>Deceased</value>
        </criteriaItems>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Do Not Contact is Selected</fullName>
        <actions>
            <name>Update_Do_Not_Contact_Date_Field</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>Contact.Do_Not_Contact__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <description>If user checks the &quot;Do Not Contact&quot; checkbox on the Contact, the &quot;Do Not Contact Date&quot; field should auto-populate with that day&apos;s date.</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Mailing Address Flag Checked Populated Secondary Address</fullName>
        <actions>
            <name>Update_Secondary_City</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Update_Secondary_Country</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Update_Secondary_State</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Update_Secondary_Street</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Update_Secondary_Zip</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>Contact.Mailing_Address_Flag__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <description>If the Mailing Address Flag checkbox is checked, all fields on the Secondary Address should populate with the Mailing Address field values</description>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Update Preferred Phone Number Field</fullName>
        <actions>
            <name>Update_Preferred_Phone_Number_Field</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <description>Populates the Preferred_Phone_Number__c field with the value of the phone selected as the primary phone.</description>
        <formula>ISCHANGED( Primary_Phone__c)</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
</Workflow>
