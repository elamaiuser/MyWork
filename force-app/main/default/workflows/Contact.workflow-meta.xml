    <fieldUpdates>
        <fullName>Update_Preferred_Phone_Number_Field</fullName>
        <description>Populates the Preferred_Phone_Number__c field with the value of the phone selected as the primary phone.</description>
        <field>Phone</field>
        <formula>If(
ISPICKVAL( Primary_Phone__c ,&quot;Home Phone&quot;),HomePhone,
if(
ISPICKVAL(Primary_Phone__c,&quot;Mobile Phone&quot;), MobilePhone,
if(
ISPICKVAL(Primary_Phone__c,&quot;Work Phone&quot;), OtherPhone,
if(
ISPICKVAL(Primary_Phone__c,&quot;&quot;), &quot;&quot;,

NULL
)
)
)
)</formula>
        <name>Update Preferred Phone Number Field</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
