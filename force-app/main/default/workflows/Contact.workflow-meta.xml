    <rules>
        <fullName>Do Not Contact Reasons Equals to Deceased</fullName>
        <actions>
            <name>Active_Inactive_is_false</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>Contact.Do_Not_Contact_Reason__c</field>
            <operation>equals</operation>
            <value>Deceased</value>
        </criteriaItems>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Do Not Contact is Selected</fullName>
        <actions>
            <name>Update_Do_Not_Contact_Date_Field</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>Contact.Do_Not_Contact__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <description>If user checks the &quot;Do Not Contact&quot; checkbox on the Contact, the &quot;Do Not Contact Date&quot; field should auto-populate with that day&apos;s date.</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
