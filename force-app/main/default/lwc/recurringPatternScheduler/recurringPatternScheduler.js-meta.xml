<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>51.0</apiVersion>
    <isExposed>true</isExposed>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__FlowScreen</target>
    </targets>
  <targetConfigs>
         <targetConfig targets="lightning__FlowScreen">

            <property name="InputStartDateOffset" label="How many Days in Future should Start Date be (-1 for no restriction)" type="Integer"/>
            <property name="InputEndtDateOffset" label="How many Days in Future can End Date be (-1 for no restriction)" type="Integer"/>
            <property name="InputEnableFlowButtons" label="Show Flow Buttons in Component" type="Boolean" />
            <property name="InputDriveType" label="Drive Type" type="String"/>

             <property name="OutputStartDateValue" label="Start Date" type="String"/>
             <property name="OutputEndDateValue" label="End Date" type="String"/>
             <property name="OutputRecurTypeValue" label="Recurrence Type" type="String"/>
             <property name="OutputDonorEligibilityNeededFor" label="Donor Eligibility (Depricated)" type="String[]"/>
             <property name="OutputDonorEligibilityType" label="Donor Eligibility calculation needed for which type?" type="String"/>
             <property name="OutputDonorEligibilityDay" label="Donor Eligibility Day" type="String"/>

             <property name="OutputMonthlyFrequencyValue" label="Monthly Frequency" type="Integer"/>
             <property name="OutputMonthDayOccuranceValue" label="Day or Week of Month" type="String"/>
             <property name="OutputMonthDayValue" label="Day of Month" type="String"/>

             <property name="OutputWeeklyFrequencyValue" label="Weekly Frequency" type="Integer"/>
             <property name="OutputWeeklyFreqDay" label="Days of Week" type="String"/>

             <property name="OutputStartDate" label="Start Date (Date Type)" type="Date" role="outputOnly"/>
             <property name="OutputDates" label="Output Dates as Stringified Array" type="String"/>
             <property name="OutputDateList" label="Output Date String List" type="String[]" />
             <property name="OutputDateValues" label="Output Date List" type="Date[]" />
         </targetConfig>
  </targetConfigs>
</LightningComponentBundle>
