        <value xsi:type="xsd:string">&lt;p&gt;Hello &lt;b&gt;{{Owner.FirstName}}&lt;/b&gt;,&lt;/p&gt;

&lt;p&gt;A change has occurred which affects the indicated blood pickup job and TMS Movement.&lt;/p&gt;
&lt;table style=&quot;border-collapse: collapse; margin: 15px 0;&quot;&gt;
  &lt;tr&gt;
    &lt;td style=&quot;padding: 4px 8px; font-weight: bold;&quot;&gt;Blood Drive Name:&lt;/td&gt;
    &lt;td style=&quot;padding: 4px 8px;&quot;&gt;
      &lt;a href=&quot;{{Salesforce_Url__c}}{{Primary_Drive__c}}/view&quot;&gt;
        {{Primary_Drive__r.Name}}
      &lt;/a&gt;
    &lt;/td&gt;
  &lt;/tr&gt;
  &lt;tr&gt;
    &lt;td style=&quot;padding: 4px 8px; font-weight: bold;&quot;&gt;Blood Pickup Job:&lt;/td&gt;
    &lt;td style=&quot;padding: 4px 8px;&quot;&gt;
      &lt;a href=&quot;{{Salesforce_Url__c}}{{Primary_Drive_Delivery_Job__c}}/view&quot;&gt;
        {{Primary_Drive_Delivery_Job__r.Name}}
      &lt;/a&gt;
    &lt;/td&gt;
  &lt;/tr&gt;
  &lt;tr&gt;
    &lt;td style=&quot;padding: 4px 8px; font-weight: bold;&quot;&gt;TMS Movement Number:&lt;/td&gt;
    &lt;td style=&quot;padding: 4px 8px;&quot;&gt;
      &lt;a href=&quot;{{Salesforce_Url__c}}{{Id}}/view&quot;&gt;
        {{Movement_Number__c}}
      &lt;/a&gt;
    &lt;/td&gt;
  &lt;/tr&gt;
  &lt;tr&gt;
    &lt;td style=&quot;padding: 4px 8px; font-weight: bold;&quot;&gt;Change:&lt;/td&gt;
    &lt;td style=&quot;padding: 4px 8px;&quot;&gt;Blood Drive Site address modified&lt;/td&gt;
  &lt;/tr&gt;
&lt;/table&gt;

&lt;p&gt;Please log in to Salesforce, review your assigned movements, and adjust any dependent logistics or schedules accordingly.&lt;/p&gt;</value>
