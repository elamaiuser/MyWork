<apex:page controller="WeeklyStaffScheduleReportController" renderAs="pdf" showHeader="false" applyBodyTag="false" applyHtmlTag="false">
<html>
<head>
    <style>
    @page {
        size: A4 landscape;
        margin: 15mm;
        @top-center {
            content: element(header);
        }
        @bottom-right {
            content: "Page " counter(page) " of " counter(pages);
            font-size: 8.5px;           
            font-family: Arial, sans-serif;     
        }
    }

    body {
        font-family: Arial, sans-serif !important;
        font-size: 9px !important;
    }

    table {
        width: 100% !important;
        border-collapse: separate !important;
        border-spacing: 0px !important;
        table-layout: fixed !important;
        -fs-table-paginate: paginate !important;
    }

    th, td {
        border-bottom: 0.5pt solid #000 !important;
        padding: 2px !important;
        font-size: 8px !important;
        word-wrap: break-word !important;
        overflow-wrap: break-word !important;
        hyphens: auto !important;
        vertical-align: top !important;
        white-space: pre-line !important;
        page-break-inside: avoid !important;
        break-inside: avoid !important;
    }

    tr {
        page-break-inside: avoid !important;
        break-inside: avoid !important;
    }

    thead th {
        border-top: 0.5pt solid #000 !important;
        border-right: 0.5pt solid #000 !important;
        border-bottom: 0.5pt solid #000 !important;
        text-align: center !important;
        font-weight: bold !important;
        font-size: 9.5px !important; 
        background-color: #f0f0f0 !important;
    }

    thead th:first-child {
        border-left: 0.5pt solid #000 !important;
    }

    thead th:last-child {
        border-right: 0.5pt solid #000 !important;
    }

    tbody td:first-child {
        border-left: 0.5pt solid #000 !important;
    }

    tbody td {
        border-right: 0.5pt solid #000 !important;
    }

    tr:first-child td {
        border-top: 0.5pt solid #000 !important;
    }

    div.header {
        position: running(header);
        text-align: center !important;
        font-size: 14px !important;
        font-weight: bold !important;
        margin-bottom: 10px !important;
    }

</style>
</head>
<body>
    <div class="header">
        Weekly Staffing Schedule Report by Employee
    </div>

    <table border="0" cellpadding="0" cellspacing="0" class="fixed">
        <thead>
            <tr>
                <apex:repeat value="{!wrapper.headerWrapper}" var="headdata"> 
                    <th style="width:{!100 / wrapper.headerWrapper.size}% !important;">{!headdata}</th>
                </apex:repeat>
            </tr>
        </thead>
        <tbody>
            <apex:repeat value="{!wrapper.dataWrapper}" var="rowdata"> 
                <tr>
                    <apex:variable var="index" value="{!0}" />
                    <apex:repeat value="{!rowdata}" var="coldata">
                        <td style="
                            width:{!100 / wrapper.headerWrapper.size}% !important;
                            text-align:{!IF(index = (wrapper.headerWrapper.size - 1), 'center', 'left')} !important;
                            font-weight:{!IF(index = (wrapper.headerWrapper.size - 1), 'bold', 'normal')} !important;
                        ">
                            <apex:outputText value="{!coldata}" escape="false"/>
                        </td>
                        <apex:variable var="index" value="{!index + 1}" />
                    </apex:repeat>
                </tr>
            </apex:repeat>
        </tbody>
    </table>
</body>
</html>
</apex:page>