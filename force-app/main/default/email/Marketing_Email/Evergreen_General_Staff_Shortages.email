 <v:imagedata src="file:///C:/Users/NORMA~1.MIT/AppData/Local/Temp/msohtmlclip1/01/clip_image001.jpg"
  o:title="For mother and son, blood donations changed everything"/>
</v:shape><![endif]--><!--[if !vml]--><img border="0" width="305" height="218" src="file:///C:/Users/NORMA~1.MIT/AppData/Local/Temp/msohtmlclip1/01/clip_image001.jpg" alt="For mother and son, blood donations changed everything" v:shapes="Video_x0020_2"><!--[endif]--></span></a><o:p></o:p></p><p class="MsoNormal" style="margin-bottom:0in;line-height:normal"><o:p>&nbsp;</o:p></p><p class="MsoNormal" style="margin-bottom:0in;line-height:normal">Please feel free to call me with any questions.<o:p></o:p></p><p class="MsoNormal" style="margin-bottom:0in;line-height:normal"><o:p>&nbsp;</o:p></p><p class="MsoNormal" style="margin-bottom:0in;line-height:normal">Sincerely,<o:p></o:p></p><p class="MsoNormal" style="margin-bottom:0in;line-height:normal"><o:p>&nbsp;</o:p></p><p class="MsoHeader">



























































</p><p class="MsoNormal" style="margin-bottom:0in;line-height:normal"><span style="mso-bidi-font-family:Calibri;mso-bidi-theme-font:minor-latin;background:
yellow;mso-highlight:yellow">&lt;&lt;Insert AM Signature&gt;&gt;</span><o:p></o:p></p><p></p>]]></td>
