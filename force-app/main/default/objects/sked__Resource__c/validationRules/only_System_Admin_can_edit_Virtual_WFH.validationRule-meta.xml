<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>only_System_Admin_can_edit_Virtual_WFH</fullName>
    <active>true</active>
    <description>Only system admin and global admin can edit the Virtual/WFH field</description>
    <errorConditionFormula>AND(
    ISCHANGED(sked_Virtual_WFH__c),
    $Profile.Name &lt;&gt; &quot;System Administrator&quot;,
    $Profile.Name &lt;&gt; &quot;Global Admin&quot;
)</errorConditionFormula>
    <errorDisplayField>sked_Virtual_WFH__c</errorDisplayField>
    <errorMessage>Only system admin and global admin can edit the Virtual/WFH field</errorMessage>
</ValidationRule>
