<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NoSpecialCharsForNationalName</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(REGEX( sked_National_Name__c,&quot;^[a-z A-Z0-9]*$&quot;))</errorConditionFormula>
    <errorMessage>Cannot use special characters for National Name.</errorMessage>
</ValidationRule>
