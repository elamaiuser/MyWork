<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RequiresLateArrivalReasons</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISPICKVAL(sked_Late_Arrival_Reasons__c , &#39;&#39;) ,
(sked_Actual_Shift_Start__c &gt; Scheduled_Shift_Start__c)
)</errorConditionFormula>
    <errorMessage>Late Arrival Reason is required.</errorMessage>
</ValidationRule>
