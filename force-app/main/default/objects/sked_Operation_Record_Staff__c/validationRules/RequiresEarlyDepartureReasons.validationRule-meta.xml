<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RequiresEarlyDepartureReasons</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISPICKVAL(sked_Early_Departure_Reasons__c , &apos;&apos;) ,
(sked_Actual_Shift_End__c &lt; Scheduled_Shift_End__c)
)</errorConditionFormula>
    <errorMessage>Early Departure Reason is required.</errorMessage>
</ValidationRule>
