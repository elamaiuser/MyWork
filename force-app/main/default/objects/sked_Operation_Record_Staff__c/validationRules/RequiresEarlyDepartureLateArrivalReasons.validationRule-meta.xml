<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RequiresEarlyDepartureLateArrivalReasons</fullName>
    <active>false</active>
    <errorConditionFormula>OR(
AND(ISPICKVAL(sked_Early_Departure_Reasons__c , &#39;&#39;) , 
    (sked_Actual_Shift_End__c &lt; sked_Scheduled_Shift_End__c)
),
AND(ISPICKVAL(sked_Late_Arrival_Reasons__c , &#39;&#39;) , 
    (sked_Actual_Shift_Start__c &gt;  sked_Scheduled_Shift_Start__c)
)
)</errorConditionFormula>
    <errorMessage>Early Departure / Late Arrival Reasons is required.</errorMessage>
</ValidationRule>
