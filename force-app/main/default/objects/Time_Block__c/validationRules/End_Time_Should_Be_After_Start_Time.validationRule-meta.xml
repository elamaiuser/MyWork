<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>End_Time_Should_Be_After_Start_Time</fullName>
    <active>true</active>
    <errorConditionFormula>Start_Time__c &gt;   End_Time__c</errorConditionFormula>
    <errorDisplayField>End_Time__c</errorDisplayField>
    <errorMessage>End Time cannot be earlier than Start Time</errorMessage>
</ValidationRule>
