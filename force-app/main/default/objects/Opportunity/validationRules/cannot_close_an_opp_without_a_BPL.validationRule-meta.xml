<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>cannot_close_an_opp_without_a_BPL</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISPICKVAL(StageName, &quot;Closed&quot;),
ISCHANGED(StageName),
ISBLANK(Account.Contact_BPL__c),
RecordType.DeveloperName = &#39;Mobile_Opp&#39;
)</errorConditionFormula>
    <errorMessage>We have hit a snag. An Active BPL is required to move this Drive to Closed Stage.</errorMessage>
</ValidationRule>
