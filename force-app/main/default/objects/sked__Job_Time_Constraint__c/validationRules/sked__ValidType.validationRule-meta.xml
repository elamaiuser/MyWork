<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>sked__ValidType</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISPICKVAL(sked__Type__c, &quot;SLA&quot;)), NOT(ISPICKVAL(sked__Type__c, &quot;Timeslot&quot;)))</errorConditionFormula>
    <errorDisplayField>sked__Type__c</errorDisplayField>
    <errorMessage>Type must be SLA or Timeslot</errorMessage>
</ValidationRule>
