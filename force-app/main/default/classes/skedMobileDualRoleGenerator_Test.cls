@isTest
private class skedMobileDualRoleGenerator_Test {

    private static sked_Drive__c queryDrive(Id driveId) {
        return [
            SELECT Id, sked_Drive_Date__c, sked_Start_Time__c, sked_End_Time__c, sked_Drive_Site__c, sked_Collection_Operation__c,
                sked_2RBC_Projected_Procedures__c, sked_WB_Projected_Procedures__c, sked_Projected_Registered_Donors__c,
                sked_APT_Quantity__c, sked_Travel_Time_Included__c, sked_Account__r.Type, sked_Account__r.Industry_Code__c,
                sked_Account__r.Accepts_Automation2__c,
                sked_Do_Not_Use_Vehicle__c, sked_Number_of_Vehicles__c, sked_Total_Vehicle_Requested__c, sked_Number_of_2RBC_Assets__c, sked_IMPACT__c,
                sked_Linked_Drives__c, sked_Linked_Drives__r.sked_Linked_Drive_Type__c
            FROM sked_Drive__c
            WHERE Id = :driveId
        ];
    }

    // Draw hours 7:00-17:00 (10 hours), CO lunch break off, autoGenerateDualRole ON by default (tests
    // that need it off flip it explicitly).
    private static sked_Drive__c setupDrive(Decimal numberOfVehicles, Decimal numberOf2rbcAssets) {
        skedTestDataFactory factory = new skedTestDataFactory('us', 30);
        factory.setupCommonTestData();
        Map<String, sObject> testData = factory.setupDriveData();

        Biomed_Collection_Op_Center__c collectionOperation = (Biomed_Collection_Op_Center__c) testData.get('testCollectionOperation1');
        collectionOperation.sked_Maximum_Shift_Length_Threshold__c = 700;
        collectionOperation.sked_No_Travel_Time__c = false;
        collectionOperation.sked_Lunch_Break__c = false;
        collectionOperation.sked_Auto_Generate_Dual_Role__c = true;
        collectionOperation.sked_Only_Generate_Dual_If_1_Machine__c = false;
        update collectionOperation;

        sked_Drive__c testDrive1 = (sked_Drive__c) testData.get('testDrive1');
        testDrive1.sked_2RBC_Projected_Procedures__c = 30;
        testDrive1.sked_WB_Projected_Procedures__c = 20;
        testDrive1.sked_Do_Not_Use_Vehicle__c = false;
        testDrive1.sked_Number_of_Vehicles__c = numberOfVehicles;
        testDrive1.sked_Number_of_2RBC_Assets__c = numberOf2rbcAssets;
        update testDrive1;

        return queryDrive(testDrive1.Id);
    }

    private static void setExcessStaffCapacityThreshold(Decimal threshold) {
        sked_Admin_Setting__c setting = sked_Admin_Setting__c.getOrgDefaults();
        setting.Admin_Excess_Staff_Capacity_Threshold__c = threshold;
        upsert setting;
    }

    private static Map<String, skedMobileRoleQuantityCalculator.RoleQuantity> generate(sked_Drive__c drive,
            skedMobileDriveShiftCalculator.MasterData masterData, skedMobileDriveShiftCalculator.DriveShiftsMetadata shiftsMetadata,
            sked_Staffing_Decision_Matrix__c sdm, Map<String, Map<String, skedMobileRoleQuantityCalculator.RoleQuantity>> roleQuantities) {
        return generate(drive, masterData, shiftsMetadata, sdm, roleQuantities,
            new List<sked_Drive_Shift__c>(), new Map<Id, List<sked__Job__c>>(), new Map<Id, List<sked__Job_Allocation__c>>());
    }

    // Fresh-generation tests funnel through the no-backup overload above (no shift has ever been
    // persisted, so there's nothing for the already-staffed gate to find); tests proving that gate
    // call this overload directly with real backup data.
    private static Map<String, skedMobileRoleQuantityCalculator.RoleQuantity> generate(sked_Drive__c drive,
            skedMobileDriveShiftCalculator.MasterData masterData, skedMobileDriveShiftCalculator.DriveShiftsMetadata shiftsMetadata,
            sked_Staffing_Decision_Matrix__c sdm, Map<String, Map<String, skedMobileRoleQuantityCalculator.RoleQuantity>> roleQuantities,
            List<sked_Drive_Shift__c> backupDriveShifts, Map<Id, List<sked__Job__c>> backupJobsByShiftId,
            Map<Id, List<sked__Job_Allocation__c>> backupAllocationsByJobId) {
        skedMobileDualRoleGenerator.generateDualRoles(roleQuantities, drive, masterData.collectionOperation, shiftsMetadata, sdm,
            drive.sked_Number_of_2RBC_Assets__c, drive.sked_Projected_Registered_Donors__c, masterData.excessStaffCapacityThreshold, masterData.timezoneSidId,
            backupDriveShifts, backupJobsByShiftId, backupAllocationsByJobId);
        return roleQuantities.get(shiftsMetadata.driveShifts[0].key);
    }

    @isTest
    static void testGenerateDualRoles_equalQuantities_fullyMergesAndRemovesBothOriginalRoles() {
        sked_Drive__c testDrive1 = setupDrive(2, 4);
        // Isolate merge mechanics from the excess-capacity gate (covered separately by
        // testGenerateDualRoles_excessCapacityGoesNegativeAfterMerge_discardsTheMerge) - the factory's
        // default sked_Projected_Registered_Donors__c otherwise pushes excessAfterMerge negative here too.
        testDrive1.sked_Projected_Registered_Donors__c = 0;
        update testDrive1;
        sked_Drive__c drive = queryDrive(testDrive1.Id);
        setExcessStaffCapacityThreshold(-100);
        skedMobileDriveShiftCalculator.MasterData masterData = skedMobileDriveShiftCalculator.loadMasterData(drive);
        skedMobileDriveShiftCalculator.DriveShiftsMetadata shiftsMetadata = skedMobileDriveShiftCalculator.calculateDriveShiftsMetadata(drive, masterData);
        sked_Staffing_Decision_Matrix__c sdm = skedMobileRoleQuantityCalculator.loadStaffingDecisionMatrix(drive.sked_Collection_Operation__c, drive.sked_Drive_Date__c);
        Map<String, Map<String, skedMobileRoleQuantityCalculator.RoleQuantity>> roleQuantities = skedMobileRoleQuantityCalculator.calculateRoleQuantities(
            drive, shiftsMetadata, sdm, masterData.driveSite.sked_Physical_Location_Type__c, masterData.timezoneSidId);
        System.assertEquals(2, roleQuantities.get(shiftsMetadata.driveShifts[0].key).get('2RBC').quantity, 'Test setup must produce equal 2RBC and Driver Support quantities');
        System.assertEquals(2, roleQuantities.get(shiftsMetadata.driveShifts[0].key).get('Driver Support').quantity, 'Test setup must produce equal 2RBC and Driver Support quantities');

        Test.startTest();
        Map<String, skedMobileRoleQuantityCalculator.RoleQuantity> result = generate(drive, masterData, shiftsMetadata, sdm, roleQuantities);
        Test.stopTest();

        System.assertEquals(false, result.containsKey('2RBC'), 'Plain 2RBC key must be removed once merged');
        System.assertEquals(false, result.containsKey('Driver Support'), 'Driver Support must be fully absorbed (no leftover) when quantities are equal');
        System.assertEquals(2, result.get('2RBC-Driver Support').quantity, 'The merged dual-role entry must carry the shared quantity');
    }

    @isTest
    static void testGenerateDualRoles_backupShiftHasStaffed2RBCAllocation_skipsMergeForThatShift() {
        sked_Drive__c testDrive1 = setupDrive(2, 4);
        testDrive1.sked_Projected_Registered_Donors__c = 0; // isolates merge mechanics from the excess-capacity gate
        update testDrive1;
        sked_Drive__c drive = queryDrive(testDrive1.Id);
        setExcessStaffCapacityThreshold(-100);
        skedMobileDriveShiftCalculator.MasterData masterData = skedMobileDriveShiftCalculator.loadMasterData(drive);
        skedMobileDriveShiftCalculator.DriveShiftsMetadata shiftsMetadata = skedMobileDriveShiftCalculator.calculateDriveShiftsMetadata(drive, masterData);
        sked_Staffing_Decision_Matrix__c sdm = skedMobileRoleQuantityCalculator.loadStaffingDecisionMatrix(drive.sked_Collection_Operation__c, drive.sked_Drive_Date__c);
        Map<String, Map<String, skedMobileRoleQuantityCalculator.RoleQuantity>> roleQuantities = skedMobileRoleQuantityCalculator.calculateRoleQuantities(
            drive, shiftsMetadata, sdm, masterData.driveSite.sked_Physical_Location_Type__c, masterData.timezoneSidId);
        System.assertEquals(2, roleQuantities.get(shiftsMetadata.driveShifts[0].key).get('2RBC').quantity, 'Test setup must produce equal 2RBC and Driver Support quantities');

        sked_Drive_Shift__c backupShift = new sked_Drive_Shift__c(sked_Drive__c = drive.Id);
        insert backupShift;
        Id regionId = [SELECT Id FROM sked__Region__c LIMIT 1].Id;
        sked__Job__c backup2rbcJob = new sked__Job__c(
            sked_Drive_Shift__c = backupShift.Id, sked_Resource_Role__c = '2RBC', sked__Quantity__c = 2,
            sked__Region__c = regionId, sked__Duration__c = 60
        );
        insert backup2rbcJob;
        sked__Resource__c resource = new sked__Resource__c(Name = 'Staffed 2RBC Tech', sked__Is_Active__c = true);
        insert resource;
        sked__Job_Allocation__c staffedAllocation = new sked__Job_Allocation__c(sked__Job__c = backup2rbcJob.Id, sked__Resource__c = resource.Id);
        insert staffedAllocation;

        Test.startTest();
        Map<String, skedMobileRoleQuantityCalculator.RoleQuantity> result = generate(drive, masterData, shiftsMetadata, sdm, roleQuantities,
            new List<sked_Drive_Shift__c>{ backupShift },
            new Map<Id, List<sked__Job__c>>{ backupShift.Id => new List<sked__Job__c>{ backup2rbcJob } },
            new Map<Id, List<sked__Job_Allocation__c>>{ backup2rbcJob.Id => new List<sked__Job_Allocation__c>{ staffedAllocation } });
        Test.stopTest();

        System.assertEquals(2, result.get('2RBC').quantity, 'A shift whose persisted 2RBC job already has a live allocation must not be merged into a dual role');
        System.assertEquals(2, result.get('Driver Support').quantity, 'Driver Support must likewise remain unmerged for this shift');
        System.assert(!result.containsKey('2RBC-Driver Support'), 'No dual-role entry must be created when the shift is already staffed');
    }

    @isTest
    static void testGenerateDualRoles_unequalQuantities_mergesMinimumAndKeepsLeftoverOnLargerRole() {
        sked_Drive__c drive = setupDrive(3, 4);
        setExcessStaffCapacityThreshold(-100);
        skedMobileDriveShiftCalculator.MasterData masterData = skedMobileDriveShiftCalculator.loadMasterData(drive);
        skedMobileDriveShiftCalculator.DriveShiftsMetadata shiftsMetadata = skedMobileDriveShiftCalculator.calculateDriveShiftsMetadata(drive, masterData);
        sked_Staffing_Decision_Matrix__c sdm = skedMobileRoleQuantityCalculator.loadStaffingDecisionMatrix(drive.sked_Collection_Operation__c, drive.sked_Drive_Date__c);
        Map<String, Map<String, skedMobileRoleQuantityCalculator.RoleQuantity>> roleQuantities = skedMobileRoleQuantityCalculator.calculateRoleQuantities(
            drive, shiftsMetadata, sdm, masterData.driveSite.sked_Physical_Location_Type__c, masterData.timezoneSidId);
        System.assertEquals(2, roleQuantities.get(shiftsMetadata.driveShifts[0].key).get('2RBC').quantity, 'Test setup must produce a smaller 2RBC quantity');
        System.assertEquals(3, roleQuantities.get(shiftsMetadata.driveShifts[0].key).get('Driver Support').quantity, 'Test setup must produce a larger Driver Support quantity');

        Test.startTest();
        Map<String, skedMobileRoleQuantityCalculator.RoleQuantity> result = generate(drive, masterData, shiftsMetadata, sdm, roleQuantities);
        Test.stopTest();

        System.assertEquals(2, result.get('2RBC-Driver Support').quantity, 'The merged entry must carry the smaller (2RBC) quantity');
        System.assertEquals(1, result.get('Driver Support').quantity, 'Driver Support must keep its own entry for the unmerged leftover (3 - 2 = 1)');
        System.assertEquals(false, result.containsKey('2RBC'), 'Plain 2RBC key must be fully absorbed - it was the smaller quantity');
    }

    @isTest
    static void testGenerateDualRoles_autoGenerateDualRoleOff_leavesRoleQuantitiesUnchanged() {
        sked_Drive__c testDrive1 = setupDrive(2, 4);
        Biomed_Collection_Op_Center__c collectionOperation = [SELECT Id FROM Biomed_Collection_Op_Center__c WHERE Id = :testDrive1.sked_Collection_Operation__c];
        collectionOperation.sked_Auto_Generate_Dual_Role__c = false;
        update collectionOperation;
        sked_Drive__c drive = queryDrive(testDrive1.Id);
        setExcessStaffCapacityThreshold(-100);

        skedMobileDriveShiftCalculator.MasterData masterData = skedMobileDriveShiftCalculator.loadMasterData(drive);
        skedMobileDriveShiftCalculator.DriveShiftsMetadata shiftsMetadata = skedMobileDriveShiftCalculator.calculateDriveShiftsMetadata(drive, masterData);
        sked_Staffing_Decision_Matrix__c sdm = skedMobileRoleQuantityCalculator.loadStaffingDecisionMatrix(drive.sked_Collection_Operation__c, drive.sked_Drive_Date__c);
        Map<String, Map<String, skedMobileRoleQuantityCalculator.RoleQuantity>> roleQuantities = skedMobileRoleQuantityCalculator.calculateRoleQuantities(
            drive, shiftsMetadata, sdm, masterData.driveSite.sked_Physical_Location_Type__c, masterData.timezoneSidId);

        Test.startTest();
        Map<String, skedMobileRoleQuantityCalculator.RoleQuantity> result = generate(drive, masterData, shiftsMetadata, sdm, roleQuantities);
        Test.stopTest();

        System.assertEquals(true, result.containsKey('2RBC'), 'With the CO flag off, no merge may occur - 2RBC must remain its own entry');
        System.assertEquals(true, result.containsKey('Driver Support'), 'With the CO flag off, no merge may occur - Driver Support must remain its own entry');
    }

    @isTest
    static void testGenerateDualRoles_excessCapacityGoesNegativeAfterMerge_discardsTheMerge() {
        sked_Drive__c testDrive1 = setupDrive(2, 4);
        testDrive1.sked_Projected_Registered_Donors__c = 100;
        update testDrive1;
        sked_Drive__c drive = queryDrive(testDrive1.Id);
        setExcessStaffCapacityThreshold(0);

        skedMobileDriveShiftCalculator.MasterData masterData = skedMobileDriveShiftCalculator.loadMasterData(drive);
        skedMobileDriveShiftCalculator.DriveShiftsMetadata shiftsMetadata = skedMobileDriveShiftCalculator.calculateDriveShiftsMetadata(drive, masterData);
        sked_Staffing_Decision_Matrix__c sdm = skedMobileRoleQuantityCalculator.loadStaffingDecisionMatrix(drive.sked_Collection_Operation__c, drive.sked_Drive_Date__c);
        Map<String, Map<String, skedMobileRoleQuantityCalculator.RoleQuantity>> roleQuantities = skedMobileRoleQuantityCalculator.calculateRoleQuantities(
            drive, shiftsMetadata, sdm, masterData.driveSite.sked_Physical_Location_Type__c, masterData.timezoneSidId);

        // Hand-calculated (Driver 2.2/Driver Support 2.2/2RBC 1.6/VP-HH 2.2 capacities, 10 draw hours,
        // 4 assets covering both 2RBC resources): staffCapacity before merge = 44+44+40+0 = 128, giving
        // excess (128-100)/22 = 1.3 >= the 0 threshold, so the merge is attempted. Merging fully
        // absorbs Driver Support's separate 44-capacity contribution (equal quantities): staffCapacity
        // after merge drops to 44+40+0 = 84, giving excess (84-100)/22 = -0.7 < 0, so the merge must be discarded.
        Test.startTest();
        Map<String, skedMobileRoleQuantityCalculator.RoleQuantity> result = generate(drive, masterData, shiftsMetadata, sdm, roleQuantities);
        Test.stopTest();

        System.assertEquals(true, result.containsKey('2RBC'), 'The merge must be discarded when it would push excess capacity negative - 2RBC must remain unmerged');
        System.assertEquals(true, result.containsKey('Driver Support'), 'The merge must be discarded when it would push excess capacity negative - Driver Support must remain unmerged');
        System.assertEquals(false, result.containsKey('2RBC-Driver Support'), 'No merged dual-role entry may exist when the merge was discarded');
    }
}
